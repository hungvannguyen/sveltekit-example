# Environment variables for MySQL database connection

# Database Configuration
DB_HOST=localhost
DB_PORT=3307
DB_NAME=firebits_course
DB_USER=root
DB_PASSWORD=root

# Root password (for admin access)
DB_ROOT_PASSWORD=root

# Database URL (for Prisma or other ORMs)
DATABASE_URL="mysql://root:root@localhost:3307/firebits_course"

# Application Configuration
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here

# Development settings
NODE_ENV=development